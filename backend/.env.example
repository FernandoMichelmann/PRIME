# Copie para backend/.env. Não versionar segredos reais.
APP_NAME=PRIME API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://prime_dev:prime_dev_local_only@localhost:5432/prime_dev
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
# Apenas desenvolvimento local. Gere um segredo aleatório próprio antes de qualquer deploy.
SECRET_KEY=dev-only-change-this-secret-before-deployment-2026
ACCESS_TOKEN_EXPIRE_MINUTES=30
